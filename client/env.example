# API Configuration
# NEXT_PUBLIC_API_URL=http://localhost:8080/api

# App Configuration
# NEXT_PUBLIC_APP_NAME=Gowra
# NEXT_PUBLIC_APP_DESCRIPTION=Event Management Platform

# Payment Configuration (client)
# Toggle to show/hide checkout features in the UI
# NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Success/Cancel URLs for redirects after payment
# These should be fully-qualified URLs that your backend/provider will use
# NEXT_PUBLIC_PAYMENT_SUCCESS_URL=http://localhost:3000/payments/success
# NEXT_PUBLIC_PAYMENT_CANCEL_URL=http://localhost:3000/payments/cancel