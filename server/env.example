# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-here

# Admin Configuration
ADMIN_EMAILS=admin@example.com,admin2@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# Server Configuration
PORT=8080
NODE_ENV=development

# Payment Configuration (server)
# Feature flag to enable checkout endpoints and logic
CHECKOUT_ENABLED=false

# Client and redirect URLs used for success/cancel after payment
PAYMENT_SUCCESS_URL=http://localhost:3000/payments/success
PAYMENT_CANCEL_URL=http://localhost:3000/payments/cancel

# NextPay Configuration (for Phase 6)
NEXTPAY_API_KEY=your_nextpay_api_key_here
NEXTPAY_SECRET_KEY=your_nextpay_secret_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001 